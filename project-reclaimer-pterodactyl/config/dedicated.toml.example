# Example dedicated.toml as generated by this egg on first start.
#
# This is a REFERENCE only — the real file lives at
# /home/container/server/dedicated.toml (persistent volume) and is
# generated/patched automatically by docker/configure.py every time the
# container starts. Do not copy this file over the real one.
#
# Everything outside the "PTERODACTYL MANAGED SERVER BLOCK" markers is
# yours to edit by hand (via SFTP or the File Manager) and is preserved
# across restarts and reinstalls. Most general settings below are actually
# controlled by RECLAIMER_DEDICATED_* environment variables derived from
# the egg's Pterodactyl variables (see CONFIGURATION.md) rather than by
# editing this file directly, but the file's own values still apply to
# anything an environment variable does not override.

game = "game"
content = "content"
data = "data"
bans = "bans.json"
public_address = ""
upnp = false
auto_update = false
host_name = ""
admins = []

[master]
enabled = true
port = 49175

[rcon]
password = ""
address = "127.0.0.1"

[defaults]

# >>> PTERODACTYL MANAGED SERVER BLOCK (generated by configure.py; edits here are overwritten on every start) >>>
[[server]]
name = "My Community Server"
port = 49176
playlist = "playlists/community.playlist.json"
# <<< PTERODACTYL MANAGED SERVER BLOCK <<<
